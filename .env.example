META_ACCESS_TOKEN=<meta-api-access-token>
META_AD_ACCOUNT_ID=act_<account-id>

# ── LLM Provider (choose one) ──────────────────────────────────────────
# "openrouter" (default, remote) or "lmstudio" (local, requires LM Studio running on host)

# OpenRouter (when LLM_PROVIDER=openrouter)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-<openrouter-api-key>
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# LM Studio (when LLM_PROVIDER=lmstudio)
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LMSTUDIO_MODEL=gemma-4-e4b

# ── Databases ──────────────────────────────────────────────────────────
POSTGRES_DSN=postgresql+asyncpg://groove:groove@localhost:5432/groove
POSTGRES_READONLY_DSN=postgresql+asyncpg://groove:groove@localhost:5432/groove
MONGODB_URI=mongodb://localhost:27017/groove

# ── Application ────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
LOG_LEVEL=INFO